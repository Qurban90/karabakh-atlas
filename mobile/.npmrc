# Force devDependencies to install even when NODE_ENV=production is set during
# the install step (Render/Netlify/Vercel all inject the service's env vars
# into the build phase too — npm otherwise silently omits devDependencies,
# which breaks `tsc && vite build` since vite/typescript type packages live
# there). This makes the fix independent of whatever build command a
# platform's dashboard has cached, since it always shells out to npm here.
include=dev
