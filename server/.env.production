# QDX API — production (set a real JWT_SECRET before deploying!)
PORT=5001
# Postgres connection string. Render: injected automatically (render.yaml
# fromDatabase). Docker Compose: set by docker-compose.yml. Manual deploy:
# set this yourself — no DATABASE_URL means the JSON-file fallback (works,
# but data doesn't survive a redeploy on platforms with ephemeral disks).
DATABASE_URL=
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
# comma-separated list of allowed origins, e.g. https://qdx.example.com
CORS_ORIGIN=*
RATE_WINDOW_MS=900000
RATE_MAX=300
RATE_AUTH_MAX=20
RATE_WRITE_MAX=100
