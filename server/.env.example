# QDX API — copy to .env.development / .env.production and fill in.
# NEVER commit the filled-in file.
PORT=5001

# Postgres. Empty = JSON-file fallback (fine for local dev, no cross-restart
# persistence). Render injects this automatically via render.yaml.
DATABASE_URL=

# REQUIRED in production: the server refuses to start with a weak/default value.
# Generate one:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Staff logins. Unset = a random password is generated at seed time and
# printed once to the server log.
ADMIN_PASSWORD=
MODERATOR_PASSWORD=

# Comma-separated allowed origins. '*' is fine only while the API and the app
# are served from the same origin.
CORS_ORIGIN=*

RATE_WINDOW_MS=900000
RATE_MAX=300
RATE_AUTH_MAX=20
RATE_WRITE_MAX=100
