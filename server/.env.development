# QDX API — development
PORT=5001
# Local dev Postgres (trust-auth cluster on 5433, see start-db.cmd).
# If unreachable, the server falls back to JSON-file persistence automatically.
DATABASE_URL=postgres://qdx@localhost:5433/qdx
JWT_SECRET=qdx-dev-secret-change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
RATE_WINDOW_MS=900000
RATE_MAX=600
RATE_AUTH_MAX=30
RATE_WRITE_MAX=150
